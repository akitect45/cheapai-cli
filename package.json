{
  "name": "@akitect/cheapai",
  "version": "0.3.3",
  "description": "CheapAI coding agent with a focused terminal workspace",
  "type": "module",
  "bin": {
    "cheapai": "bin/cheapai.js"
  },
  "files": [
    "bin",
    "src",
    "docs",
    "README.md"
  ],
  "scripts": {
    "start": "node bin/cheapai.js",
    "cheapai": "node bin/cheapai.js",
    "login": "node bin/cheapai.js login",
    "test": "node scripts/test-unit.mjs && node scripts/test-e2e.mjs",
    "test:unit": "node scripts/test-unit.mjs",
    "test:smoke": "node bin/cheapai.js models",
    "test:live": "node scripts/test-e2e.mjs --live",
    "test:poll": "node scripts/test-e2e.mjs --poll-shape"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "cheapai",
    "agent",
    "cli",
    "coding-agent"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/akitect45/cheapai-cli.git"
  },
  "homepage": "https://github.com/akitect45/cheapai-cli#readme",
  "bugs": {
    "url": "https://github.com/akitect45/cheapai-cli/issues"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "commander": "^13.1.0",
    "jiti": "^2.7.0",
    "openai": "^4.104.0",
    "ws": "^8.21.3"
  }
}
